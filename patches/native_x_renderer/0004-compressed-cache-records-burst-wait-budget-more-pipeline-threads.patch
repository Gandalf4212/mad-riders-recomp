diff --git a/src/lz.cpp b/src/lz.cpp
new file mode 100644
index 0000000..5d1f4bb
--- /dev/null
+++ b/src/lz.cpp
@@ -0,0 +1,109 @@
+// NativeXRenderer - see lz.h.
+
+#include "lz.h"
+
+#include <cstring>
+
+namespace native_x_renderer::lz {
+
+namespace {
+
+constexpr size_t kMinMatch = 4;
+constexpr size_t kLastLiterals = 5;  // the block ends with literals (as LZ4's)
+constexpr unsigned kHashBits = 12;
+
+uint32_t Read32(const uint8_t* p) {
+  uint32_t v;
+  std::memcpy(&v, p, 4);
+  return v;
+}
+uint32_t Hash(uint32_t v) { return (v * 2654435761u) >> (32 - kHashBits); }
+
+void PutLength(std::vector<uint8_t>& out, size_t length) {
+  while (length >= 255) {
+    out.push_back(255);
+    length -= 255;
+  }
+  out.push_back(uint8_t(length));
+}
+
+}  // namespace
+
+void Compress(const uint8_t* data, size_t size, std::vector<uint8_t>& out) {
+  out.clear();
+  out.reserve(size / 2 + 16);
+  for (int i = 0; i < 4; ++i) out.push_back(uint8_t(size >> (8 * i)));
+  uint32_t table[1u << kHashBits];
+  std::memset(table, 0xFF, sizeof(table));
+  size_t anchor = 0, pos = 0;
+  const size_t limit = size > kLastLiterals + kMinMatch ? size - kLastLiterals - kMinMatch : 0;
+  auto emit = [&](size_t literal_end, size_t offset, size_t match_length) {
+    size_t literals = literal_end - anchor;
+    size_t token_match = match_length ? match_length - kMinMatch : 0;
+    uint8_t token = uint8_t((literals >= 15 ? 15 : literals) << 4) | uint8_t(token_match >= 15 ? 15 : token_match);
+    out.push_back(token);
+    if (literals >= 15) PutLength(out, literals - 15);
+    out.insert(out.end(), data + anchor, data + literal_end);
+    if (!match_length) return;
+    out.push_back(uint8_t(offset));
+    out.push_back(uint8_t(offset >> 8));
+    if (token_match >= 15) PutLength(out, token_match - 15);
+  };
+  while (pos < limit) {
+    uint32_t value = Read32(data + pos);
+    uint32_t h = Hash(value);
+    size_t candidate = table[h];
+    table[h] = uint32_t(pos);
+    if (candidate != 0xFFFFFFFFu && pos - candidate <= 0xFFFF && Read32(data + candidate) == value) {
+      size_t length = kMinMatch;
+      const size_t max = size - kLastLiterals - pos;
+      while (length < max && data[candidate + length] == data[pos + length]) ++length;
+      emit(pos, pos - candidate, length);
+      pos += length;
+      anchor = pos;
+      continue;
+    }
+    ++pos;
+  }
+  emit(size, 0, 0);
+}
+
+bool Decompress(const uint8_t* data, size_t size, std::vector<uint8_t>& out) {
+  if (size < 4) return false;
+  size_t expected = size_t(data[0]) | size_t(data[1]) << 8 | size_t(data[2]) << 16 | size_t(data[3]) << 24;
+  std::vector<uint8_t> result(expected);
+  size_t in = 4, at = 0;
+  auto length = [&](size_t base, size_t& value) {
+    value = base;
+    if (base != 15) return true;
+    uint8_t b;
+    do {
+      if (in >= size) return false;
+      b = data[in++];
+      value += b;
+    } while (b == 255);
+    return true;
+  };
+  while (in < size) {
+    uint8_t token = data[in++];
+    size_t literals;
+    if (!length(token >> 4, literals) || literals > size - in || literals > expected - at) return false;
+    std::memcpy(result.data() + at, data + in, literals);
+    in += literals;
+    at += literals;
+    if (in >= size) break;  // the last sequence: literals only
+    if (size - in < 2) return false;
+    size_t offset = size_t(data[in]) | size_t(data[in + 1]) << 8;
+    in += 2;
+    size_t match;
+    if (!offset || offset > at || !length(token & 15, match)) return false;
+    match += kMinMatch;
+    if (match > expected - at) return false;
+    for (size_t i = 0; i < match; ++i, ++at) result[at] = result[at - offset];  // may overlap
+  }
+  if (at != expected) return false;
+  out.swap(result);
+  return true;
+}
+
+}  // namespace native_x_renderer::lz
diff --git a/src/lz.h b/src/lz.h
new file mode 100644
index 0000000..7439a6b
--- /dev/null
+++ b/src/lz.h
@@ -0,0 +1,21 @@
+// NativeXRenderer - a small LZ77 block compressor for the shader cache file (internal, D117).
+//
+// The LZ4 block format's layout (token, literal run, 16-bit offset, match run), written from scratch: greedy
+// matching through a 4096-entry hash table, compressing at hundreds of MB/s and decompressing faster. SPIR-V is
+// repetitive (ids, decorations, the same instruction shapes), so it shrinks several times. Decompression runs on
+// the shader workers (the stored SPIR-V of a translation) and on the preparing thread (the driver's cache), never on
+// the renderer's thread.
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace native_x_renderer::lz {
+
+// `out` gets the uncompressed size (4 bytes, little-endian) then the compressed block.
+void Compress(const uint8_t* data, size_t size, std::vector<uint8_t>& out);
+// False if `data` is not a valid block (then `out` is unchanged).
+bool Decompress(const uint8_t* data, size_t size, std::vector<uint8_t>& out);
+
+}  // namespace native_x_renderer::lz
