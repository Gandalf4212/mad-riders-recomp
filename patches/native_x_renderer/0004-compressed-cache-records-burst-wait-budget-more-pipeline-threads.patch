+bool PipelineStorage::Unpack(const std::vector<uint8_t>& stored, std::vector<uint32_t>& spirv) {
+  std::vector<uint8_t> bytes;
+  const std::vector<uint8_t>* source = &stored;
+  if (IsPacked(stored)) {
+    std::vector<uint8_t> body(stored.begin() + 4, stored.end());
+    if (!lz::Decompress(body.data(), body.size(), bytes)) return false;
+    source = &bytes;
+  }
+  if (source->size() < 20 || source->size() % 4) return false;
+  spirv.resize(source->size() / 4);
+  std::memcpy(spirv.data(), source->data(), source->size());
+  return spirv[0] == 0x07230203u;  // the SPIR-V magic
+}
+
