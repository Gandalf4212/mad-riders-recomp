+// D117: a blob that starts with this is compressed (lz.h); SPIR-V as older files kept it starts with 0x07230203.
+constexpr uint8_t kPacked[4] = {'N', 'X', 'Z', '1'};
+
+std::vector<uint8_t> Pack(const void* data, size_t size) {
+  std::vector<uint8_t> packed;
+  lz::Compress(static_cast<const uint8_t*>(data), size, packed);
+  packed.insert(packed.begin(), kPacked, kPacked + 4);
+  return packed;
+}
+
+bool IsPacked(const std::vector<uint8_t>& bytes) {
+  return bytes.size() >= 8 && std::memcmp(bytes.data(), kPacked, 4) == 0;
+}
 
