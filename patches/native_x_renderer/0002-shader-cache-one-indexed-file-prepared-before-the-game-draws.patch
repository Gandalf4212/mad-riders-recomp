+// NativeXRenderer - see include/native_x_renderer/shader_cache_screen.h.
+#include <native_x_renderer/shader_cache_screen.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+
+#include <imgui.h>
+
+#include <native_x_renderer/native_x_renderer.h>
+
+#include <string>
+
+namespace native_x_renderer {
+namespace {
+
+using Status = ShaderCacheStatus;
+using Phase = Status::Phase;
+
+const ImU32 kBackdrop = IM_COL32(8, 10, 16, 255);
+const ImU32 kPanel = IM_COL32(20, 24, 36, 245);
+const ImU32 kTrack = IM_COL32(38, 44, 62, 255);
+const ImU32 kText = IM_COL32(235, 238, 245, 255);
+const ImU32 kDim = IM_COL32(150, 158, 178, 255);
+const ImU32 kDone = IM_COL32(110, 210, 120, 255);
+
+struct Step {
+  Phase phase;
+  const char* label;
+  float weight_build, weight_load;  // share of the bar on a build (first launch) and on a normal start
+};
+const Step kSteps[] = {
+    {Phase::kScanning, "Find the game's shaders", 0.08f, 0.0f},
+    {Phase::kAnalyzing, "Analyze shaders", 0.12f, 0.20f},
+    {Phase::kTranslating, "Compile shaders", 0.55f, 0.30f},
+    {Phase::kPipelines, "Build pipelines", 0.20f, 0.45f},
+    {Phase::kSaving, nullptr, 0.05f, 0.05f},  // "Save <file name>"
+};
+
+bool Preparing(Phase p) { return p != Phase::kNone && p != Phase::kReady; }
+
+float Overall(const Status& s) {
+  float total = 0, done = 0;
+  for (const Step& step : kSteps) {
+    float w = s.building ? step.weight_build : step.weight_load;
+    total += w;
+    if (uint32_t(step.phase) < uint32_t(s.phase)) {
+      done += w;
+    } else if (step.phase == s.phase && s.total) {
+      done += w * std::clamp(float(s.done) / float(s.total), 0.0f, 1.0f);
+    }
+  }
+  if (s.phase == Phase::kReady) return 1.0f;
+  return total > 0 ? done / total : 0.0f;
+}
+
+void Bytes(char* out, size_t size, uint64_t bytes) {
+  if (bytes >= (1ull << 20)) {
+    std::snprintf(out, size, "%.1f MB", double(bytes) / double(1 << 20));
+  } else {
+    std::snprintf(out, size, "%llu KB", (unsigned long long)(bytes >> 10));
+  }
+}
+
+void Centered(ImDrawList* dl, ImFont* font, float size, float cx, float y, ImU32 color, const char* text) {
+  ImVec2 ext = font->CalcTextSizeA(size, 10000.0f, 0.0f, text);
+  dl->AddText(font, size, ImVec2(cx - ext.x * 0.5f, y), color, text);
+}
+
+ImU32 Alpha(ImU32 c, float a) {
+  uint32_t alpha = uint32_t(float((c >> IM_COL32_A_SHIFT) & 0xFF) * std::clamp(a, 0.0f, 1.0f));
+  return (c & ~IM_COL32_A_MASK) | (alpha << IM_COL32_A_SHIFT);
+}
+
+}  // namespace
+
+void ShaderCacheScreen::OnDraw(ImGuiIO& io) {
+  if (finished_) return;
+  const ImU32 kPanelEdge = style_.edge, kBarLeft = style_.bar_left, kBarRight = style_.bar_right;
+  const ImU32 kAccent = style_.accent;
+  Status s = native_x_renderer::GetShaderCacheStatus();
+  if (Preparing(s.phase)) seen_ = true;
+  if (!seen_) return;  // not started yet, or no cache (another renderer)
+
+  // After the last step: "Ready" for a moment, then a fade into the game.
+  float fade = 1.0f;
+  if (s.phase == Phase::kReady) {
+    auto now = std::chrono::steady_clock::now();
+    if (ready_at_ == std::chrono::steady_clock::time_point{}) ready_at_ = now;
+    float t = std::chrono::duration<float>(now - ready_at_).count();
+    fade = 1.0f - std::clamp((t - 0.5f) / 0.5f, 0.0f, 1.0f);
+    if (fade <= 0.0f) {
+      finished_ = true;
+      return;
+    }
+  }
+  float target = Overall(s);
+  // Smoothed, never backwards.
+  shown_progress_ = std::max(shown_progress_, shown_progress_ + (target - shown_progress_) * 0.25f);
+  if (s.phase == Phase::kReady) shown_progress_ = 1.0f;
+
+  ImDrawList* dl = ImGui::GetForegroundDrawList();
+  ImFont* font = ImGui::GetFont();
+  const float base = ImGui::GetFontSize();
+  const ImVec2 screen = io.DisplaySize;
+  const float scale = std::clamp(screen.y / 720.0f, 0.8f, 2.5f);
+  dl->AddRectFilled(ImVec2(0, 0), screen, Alpha(kBackdrop, fade));
+
+  // The panel.
+  const float w = std::min(screen.x - 40.0f, 620.0f * scale), h = 400.0f * scale;
+  const float x0 = (screen.x - w) * 0.5f, y0 = (screen.y - h) * 0.5f;
+  const float cx = screen.x * 0.5f;
+  dl->AddRectFilled(ImVec2(x0, y0), ImVec2(x0 + w, y0 + h), Alpha(kPanel, fade), 12.0f * scale);
+  dl->AddRect(ImVec2(x0, y0), ImVec2(x0 + w, y0 + h), Alpha(kPanelEdge, fade), 12.0f * scale, 0, 1.5f * scale);
+  dl->AddRectFilledMultiColor(ImVec2(x0 + 24 * scale, y0 + 4 * scale), ImVec2(x0 + w - 24 * scale, y0 + 7 * scale),
+                              Alpha(kBarLeft, fade), Alpha(kBarRight, fade), Alpha(kBarRight, fade),
+                              Alpha(kBarLeft, fade));
+
+  float y = y0 + 26 * scale;
+  Centered(dl, font, base * 2.0f * scale, cx, y, Alpha(kAccent, fade), style_.title.c_str());
+  y += base * 2.3f * scale;
+  const char* title = s.phase == Phase::kReady ? "Shaders ready"
+                      : s.building             ? "Building the shader cache"
+                                               : "Loading the shader cache";
+  Centered(dl, font, base * 1.25f * scale, cx, y, Alpha(kText, fade), title);
+  y += base * 1.6f * scale;
+  char note[192];
+  std::snprintf(note, sizeof note,
+                s.building ? "First launch: every shader the game ships is compiled once into %s."
+                           : "Shaders and pipelines from %s, ready before the game starts.",
+                style_.file_name.c_str());
+  Centered(dl, font, base * 0.9f * scale, cx, y, Alpha(kDim, fade), note);
+  y += base * 2.0f * scale;
+
+  // The bar, with its percentage.
+  const float bx0 = x0 + 36 * scale, bx1 = x0 + w - 36 * scale, bh = 22 * scale;
+  dl->AddRectFilled(ImVec2(bx0, y), ImVec2(bx1, y + bh), Alpha(kTrack, fade), bh * 0.5f);
+  float fill = bx0 + (bx1 - bx0) * std::clamp(shown_progress_, 0.0f, 1.0f);
+  if (fill > bx0 + 2) {
+    dl->PushClipRect(ImVec2(bx0, y), ImVec2(fill, y + bh), true);
+    dl->AddRectFilledMultiColor(ImVec2(bx0, y), ImVec2(bx1, y + bh), Alpha(kBarLeft, fade), Alpha(kBarRight, fade),
+                                Alpha(kBarRight, fade), Alpha(kBarLeft, fade));
+    // A moving sheen while working.
+    if (s.phase != Phase::kReady) {
+      float t = float(ImGui::GetTime());
+      float sx = bx0 + std::fmod(t * 260.0f * scale, (bx1 - bx0) + 120 * scale) - 60 * scale;
+      dl->AddRectFilledMultiColor(ImVec2(sx - 40 * scale, y), ImVec2(sx + 40 * scale, y + bh), IM_COL32(255, 255, 255, 0),
+                                  Alpha(IM_COL32(255, 255, 255, 70), fade), Alpha(IM_COL32(255, 255, 255, 70), fade),
+                                  IM_COL32(255, 255, 255, 0));
+    }
+    dl->PopClipRect();
+  }
+  char pct[16];
+  std::snprintf(pct, sizeof pct, "%.0f%%", shown_progress_ * 100.0f);
