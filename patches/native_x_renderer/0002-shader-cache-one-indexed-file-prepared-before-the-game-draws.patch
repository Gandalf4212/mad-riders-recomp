new file mode 100644
index 0000000..b797830
--- /dev/null
+++ b/include/native_x_renderer/shader_sources.h
@@ -0,0 +1,58 @@
+// NativeXRenderer - finding the shaders a game ships, for the shader cache's first build (D115).
+//
+// SetShaderCache (native_x_renderer.h) takes a fingerprint and a scan function that returns every shader
+// the game ships. These helpers cover the usual cases, so a game's scan is a few lines:
+//
+//   - FindXdkShaders: XDK compiled shader objects (what the XDK's shader compiler writes, and what
+//     D3DDevice_CreateVertexShader / CreatePixelShader take) stored whole, the microcode right after the
+//     object's header ("virtual" part). Games that keep .xvu/.xpu-style blobs, or effect files and packs
+//     that embed them uncompressed, are covered by running it over the file's (or the inflated section's)
+//     bytes.
+//   - FindXdkShadersSplit: the same objects with the microcode ("physical" part) cut out and kept in a
+//     separate buffer, one object after another, each on an `alignment`-byte boundary (Mad Riders' Chrome
+//     Engine .rpack: sections 0x30 and 0x31, alignment 32).
+//   - ListFiles / FingerprintFiles: the files to read (by extension, recursively or not) and a fingerprint
+//     of their names and sizes, quick to compute at every start.
+//
+// An XDK shader object starts with a big-endian header: magic 0x102A1101 (vertex) or 0x102A1100 (pixel),
+// the virtual size, the physical size, then at +24 the offset (in the virtual part) of the shader's
+// description, whose first two words are the microcode's offset and size in the physical part. See
+// docs/shader-cache.md for how to find where a game keeps them (and how to check with a Xenia dump).
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+#include <native_x_renderer/native_x_renderer.h>
+
+namespace native_x_renderer::shader_sources {
+
+inline constexpr uint32_t kXdkVertexShaderMagic = 0x102A1101;
+inline constexpr uint32_t kXdkPixelShaderMagic = 0x102A1100;
+
+// Appends the shader objects found in `data` (searched at every 4-byte boundary), microcode inline, to `out`.
+// Returns how many were found (duplicates included; Deduplicate removes them).
+size_t FindXdkShaders(const uint8_t* data, size_t size, std::vector<GameShader>& out);
+
+// The objects in `headers` (microcode cut out), their microcode taken in order from `microcode`, each object's
+// physical part starting on an `alignment`-byte boundary there.
+size_t FindXdkShadersSplit(const uint8_t* headers, size_t headers_size, const uint8_t* microcode,
+                           size_t microcode_size, size_t alignment, std::vector<GameShader>& out);
+
+// Keeps the first of the shaders with the same type and microcode.
+void Deduplicate(std::vector<GameShader>& shaders);
+
+// The regular files under `dir` whose extension is one of `extensions` (lowercase, with the dot, e.g. ".rpack";
+// empty: every file), sorted.
+std::vector<std::filesystem::path> ListFiles(const std::filesystem::path& dir, const std::vector<std::string>& extensions,
+                                             bool recursive = false);
+
+// A fingerprint of the files' names (relative to `dir`) and sizes, and of `version` (bump it when the scan
+// finds more: the next start builds the game's shaders again). Never 0.
+uint64_t FingerprintFiles(const std::filesystem::path& dir, const std::vector<std::filesystem::path>& files,
+                          uint32_t version);
+
+}  // namespace native_x_renderer::shader_sources
