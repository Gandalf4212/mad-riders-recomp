+// NativeXRenderer - see include/native_x_renderer/shader_sources.h.
+
+#include <native_x_renderer/shader_sources.h>
+
+#include <algorithm>
+#include <cctype>
+#include <cstring>
+#include <system_error>
+#include <unordered_set>
