+    float r = 5.0f * scale, my = y + row * 0.4f;
+    if (done) {
+      dl->AddCircleFilled(ImVec2(sx, my), r, Alpha(color, fade));
+    } else if (current) {
+      float pulse = 0.5f + 0.5f * std::sin(float(ImGui::GetTime()) * 6.0f);
+      dl->AddCircleFilled(ImVec2(sx, my), r * (0.7f + 0.3f * pulse), Alpha(color, fade));
+    } else {
+      dl->AddCircle(ImVec2(sx, my), r, Alpha(color, fade), 0, 1.5f * scale);
+    }
+    std::string label = step.label ? step.label : "Save " + style_.file_name;
+    dl->AddText(font, base * scale, ImVec2(sx + 16 * scale, y), Alpha(done || current ? kText : kDim, fade),
+                label.c_str());
+    y += row;
+  }
+
+  // What the file holds.
+  char size[32];
+  Bytes(size, sizeof size, s.file_bytes);
+  std::snprintf(line, sizeof line, "%s   %u shaders   %u compiled   %u pipelines   %s", style_.file_name.c_str(),
+                s.shaders, s.translations, s.pipelines, size);
+  Centered(dl, font, base * 0.85f * scale, cx, y0 + h - base * 2.6f * scale, Alpha(kDim, fade), line);
+  if (s.failed || s.pipelines_failed) {
+    std::snprintf(line, sizeof line, "%u shaders and %u pipelines could not be built (see the log); they are skipped",
+                  s.failed, s.pipelines_failed);
+  } else {
+    std::snprintf(line, sizeof line, "%.1f s", s.seconds);
+  }
+  Centered(dl, font, base * 0.85f * scale, cx, y0 + h - base * 1.5f * scale, Alpha(kDim, fade), line);
+}
