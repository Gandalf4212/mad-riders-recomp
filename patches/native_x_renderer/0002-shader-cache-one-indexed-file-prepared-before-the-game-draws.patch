+  } else if (s.total > 1) {
+    std::snprintf(line, sizeof line, "%s   %u / %u", ShaderCachePhaseName(s.phase), s.done, s.total);
+  } else {
+    std::snprintf(line, sizeof line, "%s", ShaderCachePhaseName(s.phase));
+  }
+  Centered(dl, font, base * 0.95f * scale, cx, y, Alpha(kDim, fade), line);
+  y += base * 1.9f * scale;
+
+  // The steps.
+  const float sx = x0 + 70 * scale, row = base * 1.35f * scale;
+  for (const Step& step : kSteps) {
+    if (!s.building && step.phase == Phase::kScanning) continue;
+    bool done = uint32_t(step.phase) < uint32_t(s.phase);
+    bool current = step.phase == s.phase;
