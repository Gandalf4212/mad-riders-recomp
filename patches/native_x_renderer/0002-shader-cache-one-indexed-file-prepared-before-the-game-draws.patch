+// NativeXRenderer - a ready-made status screen for the shader cache (D115), as a Dear ImGui dialog of the
+// SDK's ImGuiDrawer. While the renderer prepares the cache file before the game's first frame, the window shows
+// the game's ImGui dialogs on black: this one draws a full-window panel with the game's name, a progress bar
+// over the whole preparation, the steps, and what the file holds; then "Ready", and a short fade into the game.
+// It reads GetShaderCacheStatus each frame and draws nothing once done (or when there is no cache).
+//
+//   void OnCreateDialogs(rex::ui::ImGuiDrawer* drawer) override {
+//     native_x_renderer::ShaderCacheScreen::Style style;
+//     style.title = "MY GAME";
+//     screen_ = std::make_unique<native_x_renderer::ShaderCacheScreen>(drawer, style);
+//   }
+#pragma once
+
+#include <rex/ui/imgui_dialog.h>
+
+#include <chrono>
+#include <cstdint>
+#include <string>
+
+namespace native_x_renderer {
+
+class ShaderCacheScreen : public rex::ui::ImGuiDialog {
+ public:
+  struct Style {
+    std::string title = "NATIVEX";        // the game's name, at the top
+    std::string file_name = "shaders.cache";  // as the player sees it
+    uint32_t accent = 0xFF32AAFF;          // ImU32 (ABGR): the title and the current step
+    uint32_t bar_left = 0xFF1E78FF, bar_right = 0xFF3CCDFF;  // the bar's gradient
+    uint32_t edge = 0xC8B25940;            // the panel's outline
+  };
+  ShaderCacheScreen(rex::ui::ImGuiDrawer* drawer, Style style) : ImGuiDialog(drawer), style_(std::move(style)) {}
+  explicit ShaderCacheScreen(rex::ui::ImGuiDrawer* drawer) : ShaderCacheScreen(drawer, Style{}) {}
+
+ protected:
+  void OnDraw(ImGuiIO& io) override;
+
+ private:
