 namespace rex::system {
 class IGraphicsSystem;
@@ -178,6 +180,51 @@ struct Profile {
 void Initialize(const Profile& profile, rex::system::IGraphicsSystem* graphics, rex::ui::Window* window,
                 const std::filesystem::path& cache_root = {});
 
+// The shader cache file (D115): every shader, translation (SPIR-V) and pipeline the game used, and the driver's
+// pipeline binaries, in one indexed file. Without this call it is <cache_root>/native_x_renderer/<title id>.cache.
+// At each start, before the game's first frame is drawn, the renderer prepares everything the file holds (the
+// game waits, its thread blocked in the GPU's command processor, while the renderer shows GetShaderCacheStatus
+// through the game's ImGui dialogs). A game can also hand over every shader it ships: when `game_fingerprint`
+// is not the one the file was last prepared for (the first launch, other game data), `scan` is called on a
+// thread of its own and all of them are analyzed, and the pixel shaders translated, before the game starts.
+// Call before Initialize.
+struct GameShader {
+  bool pixel = false;
+  std::vector<uint32_t> ucode;  // big-endian dwords, as in guest memory
+};
+struct ShaderCacheSource {
+  std::filesystem::path file;
+  uint64_t game_fingerprint = 0;  // 0: no shaders handed over
+  // progress(done, total), from the scanning thread.
+  std::function<std::vector<GameShader>(const std::function<void(uint32_t, uint32_t)>& progress)> scan;
+};
+void SetShaderCache(ShaderCacheSource source);
+
+struct ShaderCacheStatus {
+  enum class Phase : uint32_t {
+    kNone,         // no cache (NativeXRenderer off), or not started yet
+    kOpening,      // reading the file
+    kScanning,     // the game's shaders (done/total: files)
+    kAnalyzing,    // guest microcode (done/total: shaders)
+    kTranslating,  // translations to SPIR-V and their host shaders (done/total: translations)
+    kPipelines,    // pipelines compiled by the driver (done/total: pipelines)
+    kSaving,       // the file written whole
+    kReady,        // the game runs
+  };
+  Phase phase = Phase::kNone;
+  bool building = false;  // the game's own shaders are prepared in this run (first launch, new data or device)
+  uint32_t done = 0, total = 0;
+  // In the file.
+  uint32_t shaders = 0, translations = 0, pipelines = 0;
+  uint64_t file_bytes = 0;
+  // This run: translations made from stored SPIR-V, translated, failed; pipelines that failed to compile.
+  uint32_t loaded = 0, translated = 0, failed = 0, pipelines_failed = 0;
+  double seconds = 0.0;  // since preparing started (to kReady: how long it took)
+};
+// Any thread.
+ShaderCacheStatus GetShaderCacheStatus();
+const char* ShaderCachePhaseName(ShaderCacheStatus::Phase phase);
+
 // Whether NativeXRenderer draws the game (the native_x_renderer cvar, and the renderer started), as of Initialize.
 // For game settings that NativeXRenderer does not support yet (for example POTCAWE's 2x MSAA, rendered in two
 // EDRAM tiles).
