+
+namespace {
+
+uint32_t Be32(const uint8_t* p) { return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3]; }
+
+// An object's header at `p` (`available` bytes from there): its sizes and its microcode's place in the physical
+// part. False if it is not one.
+struct Object {
+  bool pixel;
+  uint32_t virtual_size, physical_size, code_offset, code_size;
+};
+bool ReadObject(const uint8_t* p, size_t available, Object& o) {
+  if (available < 28) return false;
+  uint32_t magic = Be32(p);
+  if (magic != kXdkVertexShaderMagic && magic != kXdkPixelShaderMagic) return false;
+  o.pixel = magic == kXdkPixelShaderMagic;
+  o.virtual_size = Be32(p + 4);
+  o.physical_size = Be32(p + 8);
+  uint32_t shader_offset = Be32(p + 24);
+  if (!o.virtual_size || o.virtual_size >= 0x100000 || !o.physical_size || o.physical_size >= 0x100000 ||
+      uint64_t(shader_offset) + 8 > o.virtual_size || o.virtual_size > available) {
+    return false;
+  }
+  o.code_offset = Be32(p + shader_offset);
+  o.code_size = Be32(p + shader_offset + 4);
+  return o.code_size && o.code_size % 4 == 0 && uint64_t(o.code_offset) + o.code_size <= o.physical_size;
+}
+
+void Take(bool pixel, const uint8_t* code, uint32_t size, std::vector<GameShader>& out) {
+  GameShader shader;
+  shader.pixel = pixel;
+  shader.ucode.resize(size / 4);
+  std::memcpy(shader.ucode.data(), code, size);
+  out.push_back(std::move(shader));
+}
+
+}  // namespace
+
+size_t FindXdkShaders(const uint8_t* data, size_t size, std::vector<GameShader>& out) {
+  size_t found = 0;
+  for (size_t i = 0; i + 28 <= size; i += 4) {
+    Object o;
+    if (!ReadObject(data + i, size - i, o)) continue;
+    uint64_t code = uint64_t(i) + o.virtual_size + o.code_offset;
+    if (code + o.code_size > size) continue;
+    Take(o.pixel, data + code, o.code_size, out);
+    ++found;
+    i += ((size_t(o.virtual_size) + o.physical_size + 3) & ~size_t(3)) - 4;
+  }
+  return found;
+}
+
+size_t FindXdkShadersSplit(const uint8_t* headers, size_t headers_size, const uint8_t* microcode,
+                           size_t microcode_size, size_t alignment, std::vector<GameShader>& out) {
+  if (!alignment) alignment = 1;
+  size_t found = 0, physical = 0;
+  for (size_t i = 0; i + 28 <= headers_size; i += 4) {
+    Object o;
+    if (!ReadObject(headers + i, headers_size - i, o)) continue;
+    if (physical + o.code_offset + o.code_size <= microcode_size) {
+      Take(o.pixel, microcode + physical + o.code_offset, o.code_size, out);
+      ++found;
+    }
+    physical = (physical + o.physical_size + alignment - 1) / alignment * alignment;
+    i += ((size_t(o.virtual_size) + 3) & ~size_t(3)) - 4;
+  }
+  return found;
+}
+
+void Deduplicate(std::vector<GameShader>& shaders) {
+  std::unordered_set<uint64_t> seen;
+  size_t kept = 0;
+  for (size_t i = 0; i < shaders.size(); ++i) {
+    uint64_t key = XXH3_64bits(shaders[i].ucode.data(), shaders[i].ucode.size() * 4) ^
+                   (shaders[i].pixel ? 0x9E3779B97F4A7C15ull : 0);
+    if (!seen.insert(key).second) continue;
+    if (kept != i) shaders[kept] = std::move(shaders[i]);
+    ++kept;
+  }
+  shaders.resize(kept);
+}
+
+std::vector<std::filesystem::path> ListFiles(const std::filesystem::path& dir, const std::vector<std::string>& extensions,
+                                             bool recursive) {
+  std::vector<std::filesystem::path> files;
+  std::error_code ec;
+  auto take = [&](const std::filesystem::directory_entry& entry) {
+    if (!entry.is_regular_file(ec)) return;
+    std::string ext = entry.path().extension().string();
+    std::transform(ext.begin(), ext.end(), ext.begin(), [](unsigned char c) { return char(std::tolower(c)); });
+    if (extensions.empty() || std::find(extensions.begin(), extensions.end(), ext) != extensions.end()) {
+      files.push_back(entry.path());
+    }
+  };
+  if (recursive) {
+    for (const auto& entry : std::filesystem::recursive_directory_iterator(dir, ec)) take(entry);
+  } else {
+    for (const auto& entry : std::filesystem::directory_iterator(dir, ec)) take(entry);
+  }
+  std::sort(files.begin(), files.end());
+  return files;
+}
+
+uint64_t FingerprintFiles(const std::filesystem::path& dir, const std::vector<std::filesystem::path>& files,
+                          uint32_t version) {
+  XXH3_state_t* state = XXH3_createState();
+  XXH3_64bits_reset(state);
+  XXH3_64bits_update(state, &version, sizeof(version));
+  std::error_code ec;
+  for (const auto& path : files) {
+    std::string name = path.lexically_relative(dir).generic_string();
+    uint64_t size = std::filesystem::file_size(path, ec);
+    XXH3_64bits_update(state, name.data(), name.size());
+    XXH3_64bits_update(state, &size, sizeof(size));
+  }
+  uint64_t hash = XXH3_64bits_digest(state);
+  XXH3_freeState(state);
+  return hash ? hash : 1;
+}
+
+}  // namespace native_x_renderer::shader_sources
