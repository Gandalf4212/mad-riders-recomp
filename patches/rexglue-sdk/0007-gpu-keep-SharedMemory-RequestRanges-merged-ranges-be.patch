From 60a77d189eaab83653c4d4bfa347d24c8df5fa40 Mon Sep 17 00:00:00 2001
From: Gustavo Garcia <44309076+ElGuslml@users.noreply.github.com>
Date: Tue, 20 Oct 2026 02:59:34 -0600
Subject: [PATCH 7/8] gpu: keep SharedMemory::RequestRanges' merged ranges
 between calls

RequestRanges sorted and merged the requested ranges in a local
std::vector, reserved on entry: a heap allocation and a free in every
call, including RequestRange's single range. The command processor and
NativeXRenderer request every vertex and index buffer of every draw, so
in Kameo's first level (about 4,000 draws a frame) the allocation, the
free and the vector's growth were about 5 % of NativeXRenderer's
renderer thread (RtlAllocateHeap, RtlFreeHeap and
vector::_Reallocate under RequestRanges in a sampling profile).

The vector is now a member, merged_ranges_, cleared on entry and kept
with its capacity, as upload_ranges_ already is. RequestRanges was not
reentrant before either (upload_ranges_ is a member), and nothing it
calls requests ranges again; each SharedMemory is used by one thread.

This patch is only for projects that use NativeXRenderer; it is kept in
native_x_renderer/sdk_patches/ and applied after the shared series.

(cherry picked from commit 98462cce6686f6ad45efe941ceb51110117f9360)
(cherry picked from commit 886447c8f4ae7c2f3188c65a929b908f605b5abc)
---
 include/rex/graphics/shared_memory.h | 4 ++++
 src/graphics/shared_memory.cpp       | 4 ++--
 2 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/include/rex/graphics/shared_memory.h b/include/rex/graphics/shared_memory.h
index 4d85a2b..65c4c98 100644
--- a/include/rex/graphics/shared_memory.h
+++ b/include/rex/graphics/shared_memory.h
@@ -160,6 +160,10 @@ class SharedMemory {
   // Ranges that need to be uploaded, generated by GetRangesToUpload (a
   // persistently allocated vector).
   std::vector<std::pair<uint32_t, uint32_t>> upload_ranges_;
+  // The requested ranges, sorted and merged by RequestRanges (a persistently
+  // allocated vector too: RequestRanges runs for every vertex and index buffer
+  // of every draw).
+  std::vector<std::pair<uint32_t, uint32_t>> merged_ranges_;
 
   // Mutex between the guest memory subsystem and the command processor, to be
   // locked when checking or updating validity of pages/ranges and when firing
diff --git a/src/graphics/shared_memory.cpp b/src/graphics/shared_memory.cpp
index ec0df7c..d60d763 100644
--- a/src/graphics/shared_memory.cpp
+++ b/src/graphics/shared_memory.cpp
@@ -343,8 +343,8 @@ bool SharedMemory::RequestRanges(const std::pair<uint32_t, uint32_t>* ranges, si
   }
 
   // Some texture or buffer is empty, for example - safe to draw in this case.
-  std::vector<std::pair<uint32_t, uint32_t>> merged_ranges;
-  merged_ranges.reserve(count);
+  std::vector<std::pair<uint32_t, uint32_t>>& merged_ranges = merged_ranges_;
+  merged_ranges.clear();
   for (size_t i = 0; i < count; ++i) {
     uint32_t start = ranges[i].first;
     uint32_t length = ranges[i].second;
-- 
